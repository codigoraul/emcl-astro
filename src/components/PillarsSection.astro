---

<section class="bg-brand-900 py-24 text-white">
  <div class="mx-auto max-w-[1400px] px-6">
    <p class="mb-14 text-center text-sm font-semibold uppercase tracking-[0.25em] text-brand-logo-blue">
      {eyebrow}
    </p>

    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-5">
      {items.map((item, i) => (
        <div class="text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center text-brand-logo-blue">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-10 w-10">
              <path stroke-linecap="round" stroke-linejoin="round" d={pillarIcons[i]} />
            </svg>
          </div>
          <h3 class="text-lg font-bold">{item.title}</h3>
          <p class="mt-2 text-sm text-white/70">{item.description}</p>
        </div>
      ))}
    </div>

  </div>
</section>
