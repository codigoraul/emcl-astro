---
import { fallbackCompanyIntro } from '../content/fallback';
import { withBase } from '../lib/url';
const { eyebrow, heading, image, paragraphs, audiences } = fallbackCompanyIntro;
---

<section class="mx-auto max-w-[1400px] px-6 py-20">
  <div class="grid gap-6 lg:grid-cols-2 lg:items-center">
    <img src={withBase(image)} alt={heading} class="w-[82%] rounded-md object-cover" />
    <div class="lg:-ml-[84px]">
      <p class="text-sm font-bold uppercase tracking-[0.15em] text-brand-600">{eyebrow}</p>
      <h2 class="mt-3 text-3xl font-bold text-brand-900 md:text-4xl">{heading}</h2>
      <div class="mt-5 space-y-4 text-brand-900/80">
        {paragraphs.map((p) => (
          <p set:html={p.replace(/materiales de referencia/i, '<strong>materiales de referencia</strong>')} />
        ))}
      </div>
      <ul class="mt-5 space-y-2">
        {audiences.map((a) => (
          <li class="flex items-center gap-2 text-brand-700">
            <span class="h-1.5 w-1.5 rounded-full bg-brand-logo-blue"></span>
            {a}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
