---
// src/components/ContactForm.astro
// Formulario de contacto estático que envía por fetch() a contacto.php en el mismo hosting.
// IMPORTANTE: como el sitio es estático (build de Astro), contacto.php debe subirse
// manualmente a la raíz del hosting (o la carpeta que corresponda) junto a los archivos del build.
---

<form id="contact-form" class="contact-form" novalidate>
  <div class="field">
    <label for="nombre">Nombre *</label>
    <input type="text" id="nombre" name="nombre" required />
  </div>

  <div class="field">
    <label for="email">Correo *</label>
    <input type="email" id="email" name="email" required />
  </div>

  <div class="field">
    <label for="telefono">Teléfono</label>
    <input type="tel" id="telefono" name="telefono" />
  </div>

  <div class="field">
    <label for="empresa">Empresa</label>
    <input type="text" id="empresa" name="empresa" />
  </div>

  <div class="field">
    <label for="mensaje">Mensaje *</label>
    <textarea id="mensaje" name="mensaje" rows="5" required></textarea>
  </div>

  <!-- Honeypot anti-spam: debe quedar oculto y vacío -->
  <div class="hp-field" aria-hidden="true">
    <label for="website">No llenar este campo</label>
    <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <button type="submit" id="submit-btn">Enviar mensaje</button>

  <p id="form-status" role="status" aria-live="polite"></p>
</form>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 560px;
  }
  .field label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  .field input,
  .field textarea {
    width: 100%;
    padding: 0.65rem 0.8rem;
    border: 1px solid #d4d4d4;
    border-radius: 8px;
    font: inherit;
  }
  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  button[type="submit"] {
    align-self: flex-start;
    padding: 0.75rem 1.75rem;
    border: none;
    border-radius: 8px;
    background: #1a1a1a;
    color: #fff;
    font-weight: 600;
    cursor: pointer;
  }
  button[type="submit"]:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  #form-status {
    font-size: 0.9rem;
  }
  #form-status.success { color: #16794d; }
  #form-status.error { color: #b3261e; }
</style>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const btn = document.getElementById("submit-btn") as HTMLButtonElement;
  const status = document.getElementById("form-status") as HTMLParagraphElement;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    btn.disabled = true;
    status.className = "";
    status.textContent = "Enviando...";

    const formData = new FormData(form);

    try {
      const res = await fetch("/contacto.php", {
        method: "POST",
        body: formData,
      });
      const data = await res.json();

      if (data.ok) {
        status.className = "success";
        status.textContent = data.mensaje || "¡Gracias! Tu mensaje fue enviado correctamente.";
        form.reset();
      } else {
        status.className = "error";
        status.textContent = data.error || "Ocurrió un error. Intenta nuevamente.";
      }
    } catch (err) {
      status.className = "error";
      status.textContent = "No se pudo conectar con el servidor. Intenta más tarde.";
    } finally {
      btn.disabled = false;
    }
  });
</script>
