---

<section id="proceso" class="relative overflow-hidden bg-gray-100 py-24 text-gray-900">
  <div class="absolute inset-0">
    <img
      src="/img/bg-montana.webp"
      alt=""
      class="h-full w-full object-cover object-top opacity-60"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-gray-100 via-gray-100/60 to-gray-100/25"></div>
  </div>

  <div class="relative mx-auto max-w-[1400px] px-6">
    <div class="mb-14 max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-logo-blue">{eyebrow}</p>
      <h2 class="mt-3 text-3xl font-bold md:text-4xl">{heading}</h2>
    </div>

    <div class="process-tabs" data-process-tabs>
      <!-- Desktop: tab strip -->
      <div class="hidden gap-2 md:flex">
        {steps.map((step, i) => (
          <button
            type="button"
            class="process-tab-btn flex-1 border-b-2 border-gray-300 px-3 pb-4 text-left transition"
            class:list={[i === 0 && 'is-active']}
            data-step={i}
          >
            <span class="text-xs font-bold text-brand-logo-blue">{step.number}</span>
            <span class="mt-1 block text-sm font-bold uppercase tracking-wide text-gray-900">{step.title}</span>
          </button>
        ))}
      </div>

      <!-- Desktop: active panel -->
      <div class="hidden md:block">
        {steps.map((step, i) => (
          <div class="process-panel mt-8 rounded-2xl border border-gray-200 bg-white/90 p-8 shadow-sm backdrop-blur-sm" class:list={[i !== 0 && 'hidden']} data-panel={i}>
            <div class="flex items-start gap-6">
              <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-brand-logo-blue/15 text-brand-logo-blue">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-7 w-7">
                  <path stroke-linecap="round" stroke-linejoin="round" d={stepIcons[i]} />
                </svg>
              </span>
              <div>
                <p class="text-xs font-bold uppercase tracking-wide text-brand-logo-blue">{step.number} · {step.title}</p>
                <p class="mt-2 text-gray-700">{step.description}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Mobile: accordion -->
      <div class="space-y-3 md:hidden">
        {steps.map((step, i) => (
          <div class="accordion-item overflow-hidden rounded-xl border border-gray-200 bg-white/90 backdrop-blur-sm" class:list={[i === 0 && 'is-open']} data-accordion={i}>
            <button type="button" class="accordion-trigger flex w-full items-center justify-between gap-3 px-5 py-4 text-left">
              <span class="flex items-center gap-3">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-logo-blue/15 text-xs font-bold text-brand-logo-blue">
                  {step.number}
                </span>
                <span class="text-sm font-bold uppercase tracking-wide text-gray-900">{step.title}</span>
              </span>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="accordion-chevron h-4 w-4 shrink-0 transition-transform text-gray-500">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
              </svg>
            </button>
            <div class="accordion-content px-5 pb-5 text-sm text-gray-700">
              {step.description}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .process-tab-btn.is-active {
    border-color: var(--color-brand-logo-blue, #3b82f6);
  }
  .accordion-content {
    display: none;
  }
  .accordion-item.is-open .accordion-content {
    display: block;
  }
  .accordion-item.is-open .accordion-chevron {
    transform: rotate(180deg);
  }
</style>

<script>
  document.querySelectorAll('[data-process-tabs]').forEach((root) => {
    const tabBtns = root.querySelectorAll('.process-tab-btn');
    const panels = root.querySelectorAll('.process-panel');

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const step = btn.getAttribute('data-step');
        tabBtns.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        panels.forEach((p) => {
          p.classList.toggle('hidden', p.getAttribute('data-panel') !== step);
        });
      });
    });

    root.querySelectorAll('.accordion-item').forEach((item) => {
      const trigger = item.querySelector('.accordion-trigger');
      trigger?.addEventListener('click', () => {
        item.classList.toggle('is-open');
      });
    });
  });
</script>
