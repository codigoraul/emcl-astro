---
import type { WPContactInfo } from '../lib/wp';
import { withBase } from '../lib/url';

interface Props {
  contact: WPContactInfo;
}
const { contact } = Astro.props;
---

<section class="bg-gradient-to-br from-slate-200 via-blue-100/70 to-slate-300 py-24">
  <div class="mx-auto max-w-[1400px] px-6">
    <div class="grid overflow-hidden rounded-3xl shadow-sm lg:grid-cols-2">
      <div class="bg-white p-8 md:p-12">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-logo-blue">Escríbenos</p>
        <h2 class="mt-3 text-2xl font-bold text-brand-900 md:text-3xl">Cuéntanos sobre tu proyecto</h2>
        <p class="mt-3 text-sm text-brand-900/60">Completa el formulario y un especialista de EMCL te responderá a la brevedad.</p>

        <form id="contact-form" class="mt-8 space-y-5" method="POST" data-action={withBase('/contacto.php')}>
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="nombre" class="mb-1.5 block text-sm font-medium text-brand-900">Nombre</label>
              <input
                type="text"
                id="nombre"
                name="nombre"
                required
                class="w-full rounded-lg border border-brand-900/15 px-4 py-2.5 text-sm text-brand-900 outline-none transition focus:border-brand-logo-blue focus:ring-2 focus:ring-brand-logo-blue/20"
                placeholder="Tu nombre"
              />
            </div>
            <div>
              <label for="empresa" class="mb-1.5 block text-sm font-medium text-brand-900">Empresa</label>
              <input
                type="text"
                id="empresa"
                name="empresa"
                class="w-full rounded-lg border border-brand-900/15 px-4 py-2.5 text-sm text-brand-900 outline-none transition focus:border-brand-logo-blue focus:ring-2 focus:ring-brand-logo-blue/20"
                placeholder="Nombre de tu empresa"
              />
            </div>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="email" class="mb-1.5 block text-sm font-medium text-brand-900">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full rounded-lg border border-brand-900/15 px-4 py-2.5 text-sm text-brand-900 outline-none transition focus:border-brand-logo-blue focus:ring-2 focus:ring-brand-logo-blue/20"
                placeholder="tu@email.com"
              />
            </div>
            <div>
              <label for="telefono" class="mb-1.5 block text-sm font-medium text-brand-900">Teléfono</label>
              <input
                type="tel"
                id="telefono"
                name="telefono"
                class="w-full rounded-lg border border-brand-900/15 px-4 py-2.5 text-sm text-brand-900 outline-none transition focus:border-brand-logo-blue focus:ring-2 focus:ring-brand-logo-blue/20"
                placeholder="+56 9 1234 5678"
              />
            </div>
          </div>

          <div>
            <label for="mensaje" class="mb-1.5 block text-sm font-medium text-brand-900">Mensaje</label>
            <textarea
              id="mensaje"
              name="mensaje"
              required
              rows="5"
              class="w-full resize-none rounded-lg border border-brand-900/15 px-4 py-2.5 text-sm text-brand-900 outline-none transition focus:border-brand-logo-blue focus:ring-2 focus:ring-brand-logo-blue/20"
              placeholder="Cuéntanos qué necesitas..."
            ></textarea>
          </div>

          <!-- Honeypot anti-spam: debe quedar oculto y vacío -->
          <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
            <label for="website">No llenar este campo</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <button
            type="submit"
            id="contact-submit-btn"
            class="inline-block rounded-full bg-brand-accent px-8 py-3 text-sm font-bold uppercase tracking-wide text-white transition hover:bg-brand-700 disabled:opacity-60"
          >
            Enviar mensaje
          </button>

          <p id="contact-form-status" role="status" aria-live="polite" class="text-sm"></p>
        </form>

        <!-- Acceso destacado para clientes: formulario de especificaciones -->
        <div class="mt-10 rounded-2xl border border-brand-logo-blue/30 bg-blue-50 p-6 md:p-8">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-logo-blue">¿Ya eres cliente?</p>
          <h3 class="mt-2 text-xl font-bold text-brand-900 md:text-2xl">Formulario de Especificaciones</h3>
          <p class="mt-2 text-sm text-brand-900/60">
            Completa las especificaciones técnicas de tu solicitud de materiales de referencia.
          </p>
          <a
            href={withBase('/solicitud-especificaciones')}
            class="mt-5 inline-block rounded-full bg-brand-900 px-8 py-3 text-sm font-bold uppercase tracking-wide text-white transition hover:bg-brand-accent"
          >
            Ir al formulario de especificaciones
          </a>
        </div>
      </div>

      <div class="bg-brand-900 p-8 text-white md:p-12">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-logo-blue">Contacto</p>
        <h2 class="mt-3 text-2xl font-bold md:text-3xl">Conversemos sobre su proyecto</h2>

        <div class="mt-10 space-y-8 text-white/80">
          {contact.people && contact.people.length > 0 && (
            <div>
              <p class="text-xs uppercase tracking-wide text-white/50">Correo y teléfono</p>
              <div class="mt-2 space-y-2">
                {contact.people.map((person) => (
                  <p class="text-sm font-medium text-white">
                    <a href={`mailto:${person.email}`} class="hover:text-brand-logo-blue">{person.email}</a>
                    {' '}
                    <a href={`tel:${person.phone.replace(/\s/g, '')}`} class="text-white/70 hover:text-brand-logo-blue">{person.phone}</a>
                  </p>
                ))}
              </div>
              <p class="mt-4 text-sm text-white/70">
                Información Comercial:{' '}
                <a href={`mailto:${contact.email}`} class="text-white hover:text-brand-logo-blue">{contact.email}</a>
              </p>
            </div>
          )}
          <div>
            <p class="text-xs uppercase tracking-wide text-white/50">Ubicación</p>
            <p class="mt-1 text-lg font-medium text-white">{contact.address}, {contact.city}</p>
            <p class="text-white/60">{contact.region}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const btn = document.getElementById('contact-submit-btn') as HTMLButtonElement | null;
  const status = document.getElementById('contact-form-status') as HTMLParagraphElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!btn || !status) return;

    btn.disabled = true;
    status.className = 'text-sm text-brand-900/70';
    status.textContent = 'Enviando...';

    const formData = new FormData(form);

    try {
      const res = await fetch(form.dataset.action || '/contacto.php', {
        method: 'POST',
        body: formData,
      });
      const data = await res.json();

      if (data.ok) {
        status.className = 'text-sm text-green-700';
        status.textContent = data.mensaje || '¡Gracias! Tu mensaje fue enviado correctamente.';
        form.reset();
      } else {
        status.className = 'text-sm text-red-600';
        status.textContent = data.error || 'Ocurrió un error. Intenta nuevamente.';
      }
    } catch (err) {
      status.className = 'text-sm text-red-600';
      status.textContent = 'No se pudo conectar con el servidor. Intenta más tarde.';
    } finally {
      btn.disabled = false;
    }
  });
</script>
