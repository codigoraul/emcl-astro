---
import { fallbackWomenLeadership, fallbackCapabilities } from '../content/fallback';
const { badge, heading, intro, closing } = fallbackWomenLeadership;
---

<section class="mx-auto max-w-[1400px] px-6 py-24">
  <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
    <div>
      <span class="inline-block rounded-full bg-brand-logo-blue/10 px-4 py-1 text-xs font-semibold uppercase tracking-wide text-brand-logo-blue">
        {badge}
      </span>
      <h2 class="mt-4 text-3xl font-bold text-brand-900 md:text-4xl">{heading}</h2>
      <p class="mt-4 text-brand-900/70">{intro}</p>

      <div class="mt-8 grid gap-3 sm:grid-cols-2">
        {fallbackCapabilities.map((capability) => (
          <div class="flex items-center gap-3 rounded-lg bg-slate-50 px-4 py-3 text-sm font-medium text-brand-900">
            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-logo-blue/10 text-brand-logo-blue">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-3 w-3">
                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
              </svg>
            </span>
            {capability}
          </div>
        ))}
      </div>
    </div>

    <div class="relative overflow-hidden rounded-2xl">
      <img
        src="/img/equipo-emcl.png"
        alt="Equipo EMCL — Somos mujeres que lideran, inspiran y generan impacto"
        class="w-full object-cover"
      />
      <div class="absolute inset-x-0 bottom-0 bg-brand-900/80 px-6 py-5">
        <p class="text-lg font-semibold italic text-white">{closing}</p>
      </div>
    </div>
  </div>

</section>
