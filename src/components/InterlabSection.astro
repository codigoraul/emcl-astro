---
import { fallbackInterlabService } from '../content/fallback';
const { eyebrow, heading, intro, benefits, steps, quote } = fallbackInterlabService;
---

<section id="interlaboratorios" class="bg-slate-50 py-24">
  <div class="mx-auto max-w-[1400px] px-6">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-start">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-logo-blue">{eyebrow}</p>
        <h2 class="mt-3 text-3xl font-bold text-brand-900 md:text-4xl">{heading}</h2>
        <p class="mt-5 text-brand-900/70">{intro}</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {benefits.map((b) => (
          <div class="rounded-xl border border-brand-900/10 bg-white p-5">
            <h3 class="text-sm font-bold text-brand-900">{b.title}</h3>
            <p class="mt-1 text-sm text-brand-900/60">{b.description}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-16">
      <p class="mb-6 text-sm font-semibold uppercase tracking-wide text-brand-900/60">¿Cómo funciona nuestro servicio?</p>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
        {steps.map((step) => (
          <div class="rounded-xl bg-white p-5 shadow-sm ring-1 ring-brand-900/5">
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-logo-blue text-sm font-bold text-white">
              {step.number}
            </span>
            <h4 class="mt-3 text-sm font-bold text-brand-900">{step.title}</h4>
            <p class="mt-2 text-xs text-brand-900/60">{step.description}</p>
          </div>
        ))}
      </div>
    </div>

    <blockquote class="mt-14 border-l-4 border-brand-logo-blue pl-6 text-lg font-medium italic text-brand-900/80">
      "{quote}"
    </blockquote>
  </div>
</section>
