---
import { fallbackReferenceMaterials } from '../content/fallback';
import { withBase } from '../lib/url';
---

<section id="materiales" class="relative overflow-hidden py-24">
  <div class="absolute inset-0">
    <img
      src={withBase('/img/bg-proceso-mineral.webp')}
      alt=""
      class="h-full w-full object-cover opacity-40"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-white via-white/75 to-white/20"></div>
  </div>

  <div class="relative mx-auto max-w-[1400px] px-6">
  <div class="mb-14 max-w-2xl">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-logo-blue">Catálogo</p>
    <h2 class="mt-3 text-3xl font-bold text-brand-900 md:text-4xl">Materiales de Referencia Certificados (MRC)</h2>
    <p class="mt-4 text-brand-900/70">
      Ejemplos de nuestros Materiales de Referencia Certificados (MRC), con trazabilidad metrológica
      para respaldar análisis confiables en laboratorio e industria minera.
    </p>
  </div>

  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {fallbackReferenceMaterials.map((mr) => (
      <div class="rounded-2xl border border-brand-900/10 bg-white p-6 text-center shadow-sm">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-brand-600/10 text-brand-700">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-7 w-7">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 3h6m-5 0v4.5L5.5 17a2 2 0 0 0 1.8 3h9.4a2 2 0 0 0 1.8-3L14 7.5V3" />
          </svg>
        </div>
        <p class="mt-4 text-sm font-bold uppercase tracking-wide text-brand-900">EMCL {mr.code}</p>
        <p class="mt-1 text-lg font-semibold text-brand-logo-blue">{mr.element} {mr.value}</p>
      </div>
    ))}
  </div>

    <p class="mt-6 text-xs text-brand-900/40">
      * Valores referenciales del catálogo actual. Cifras y certificados oficiales sujetos a confirmación.
    </p>
  </div>
</section>
