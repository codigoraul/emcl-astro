---
import { siteContent, fallbackServices } from '../content/fallback';
import { withBase } from '../lib/url';
import TopBar from './TopBar.astro';

const services = fallbackServices;
---

<TopBar />
<header class="sticky top-0 z-50 border-b border-brand-900/10 bg-white/95 backdrop-blur">
  <div class="mx-auto flex max-w-[1400px] items-center justify-between px-6 py-4">
    <a href={withBase('/')} class="flex items-center">
      <img src={withBase('/img/logo-emcl.png')} alt="EMCL - Estándares Mineros Chile" class="h-[58px] w-auto" />
    </a>

    <nav class="hidden items-center gap-8 text-base font-medium text-brand-900 md:flex">
      {siteContent.nav.map((item) => (
        item.label === 'Servicios' ? (
          <div class="group relative">
            <a href={withBase(item.href)} class="inline-flex items-center gap-1.5 leading-none transition hover:text-brand-accent">
              <span>{item.label}</span>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5 shrink-0 transition-transform duration-200 group-hover:rotate-180">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
              </svg>
            </a>
            <div class="invisible absolute left-0 top-full z-50 w-max min-w-[22rem] max-w-sm translate-y-2 opacity-0 transition-all duration-200 ease-out group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
              <div class="mt-2 overflow-hidden rounded-2xl bg-brand-900 p-2 shadow-2xl shadow-brand-900/20 ring-1 ring-white/10">
                {services.map((service) => (
                  <a
                    href={withBase(`/servicios/${service.slug}`)}
                    class="group/item flex items-center justify-between gap-3 whitespace-nowrap rounded-xl px-4 py-3 text-sm font-medium text-white/85 transition hover:bg-white/10 hover:text-white"
                  >
                    <span>{service.title}</span>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4 shrink-0 -translate-x-1 text-brand-logo-blue opacity-0 transition group-hover/item:translate-x-0 group-hover/item:opacity-100">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" />
                    </svg>
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a href={withBase(item.href)} class="transition hover:text-brand-accent">{item.label}</a>
        )
      ))}
    </nav>

    <a
      href={withBase('/contacto')}
      class="hidden rounded-full bg-brand-accent px-5 py-2 text-sm font-semibold text-white transition hover:bg-brand-accent-light md:inline-block"
    >
      Contáctanos
    </a>

    <!-- Botón hamburguesa (solo mobile) -->
    <button
      id="mobile-menu-toggle"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      class="flex h-10 w-10 flex-col items-center justify-center gap-1.5 md:hidden"
    >
      <span class="block h-0.5 w-6 bg-brand-900"></span>
      <span class="block h-0.5 w-6 bg-brand-900"></span>
      <span class="block h-0.5 w-6 bg-brand-900"></span>
    </button>
  </div>
</header>

<!-- Fondo oscuro detrás del panel -->
<div
  id="mobile-menu-backdrop"
  class="pointer-events-none fixed inset-0 z-40 bg-brand-900/50 opacity-0 backdrop-blur-sm transition-opacity duration-300 md:hidden"
></div>

<!-- Panel lateral -->
<div
  id="mobile-menu"
  class="fixed inset-y-0 right-0 z-50 flex h-[100dvh] w-[78%] max-w-xs translate-x-full flex-col bg-white/95 shadow-2xl backdrop-blur-xl transition-transform duration-300 ease-out md:hidden"
>
  <div class="flex items-center justify-between border-b border-brand-900/10 px-6 py-5">
    <img src={withBase('/img/logo-emcl.png')} alt="EMCL" class="h-9 w-auto" />
    <button
      id="mobile-menu-close"
      type="button"
      aria-label="Cerrar menú"
      class="flex h-9 w-9 items-center justify-center rounded-full text-brand-900 transition hover:bg-brand-900/5"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav class="flex flex-1 flex-col gap-1 overflow-y-auto px-6 py-8">
    {siteContent.nav.map((item) => (
      item.label === 'Servicios' ? (
        <div class="mobile-services-group border-b border-brand-900/5">
          <button
            type="button"
            class="mobile-services-trigger flex w-full items-center justify-between py-3.5 text-base font-medium text-brand-900 transition hover:text-brand-accent"
          >
            {item.label}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mobile-services-chevron h-4 w-4 shrink-0 transition-transform duration-200">
              <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
            </svg>
          </button>
          <div class="mobile-services-panel hidden flex-col gap-1 pb-4 pl-1">
            <a
              href={withBase(item.href)}
              class="mobile-nav-link flex items-center gap-2 rounded-lg px-3 py-2.5 text-sm font-semibold text-brand-accent transition hover:bg-brand-accent/10"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4 shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
              </svg>
              Ver todos los servicios
            </a>
            <div class="my-1 border-t border-brand-900/5"></div>
            {services.map((service) => (
              <a
                href={withBase(`/servicios/${service.slug}`)}
                class="mobile-nav-link flex items-center gap-2 rounded-lg px-3 py-2.5 text-sm leading-snug text-brand-900/75 transition hover:bg-brand-900/5 hover:text-brand-accent"
              >
                <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-brand-logo-blue"></span>
                {service.title}
              </a>
            ))}
          </div>
        </div>
      ) : (
        <a
          href={withBase(item.href)}
          class="mobile-nav-link border-b border-brand-900/5 py-3.5 text-base font-medium text-brand-900 transition hover:text-brand-accent"
        >
          {item.label}
        </a>
      )
    ))}
  </nav>

  <div class="border-t border-brand-900/10 p-6">
    <a
      href={withBase('/contacto')}
      class="mobile-nav-link block rounded-full bg-brand-accent px-6 py-3 text-center text-sm font-semibold text-white transition hover:bg-brand-700"
    >
      Contáctanos
    </a>
  </div>
</div>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const closeBtn = document.getElementById('mobile-menu-close');
  const backdrop = document.getElementById('mobile-menu-backdrop');
  const menu = document.getElementById('mobile-menu');

  const servicesTrigger = document.querySelector('.mobile-services-trigger');
  const servicesPanel = document.querySelector('.mobile-services-panel');
  const servicesChevron = document.querySelector('.mobile-services-chevron');
  servicesTrigger?.addEventListener('click', () => {
    servicesPanel?.classList.toggle('hidden');
    servicesPanel?.classList.toggle('flex');
    servicesChevron?.classList.toggle('rotate-180');
  });

  if (toggle && menu && backdrop && closeBtn) {
    const links = menu.querySelectorAll('.mobile-nav-link');
    let open = false;

    function setOpen(next: boolean) {
      open = next;
      toggle!.setAttribute('aria-expanded', String(open));

      if (open) {
        menu!.classList.remove('translate-x-full');
        backdrop!.classList.remove('pointer-events-none', 'opacity-0');
        document.body.classList.add('overflow-hidden');
      } else {
        menu!.classList.add('translate-x-full');
        backdrop!.classList.add('opacity-0');
        setTimeout(() => backdrop!.classList.add('pointer-events-none'), 300);
        document.body.classList.remove('overflow-hidden');
      }
    }

    toggle.addEventListener('click', () => setOpen(true));
    closeBtn.addEventListener('click', () => setOpen(false));
    backdrop.addEventListener('click', () => setOpen(false));
    links.forEach((link) => link.addEventListener('click', () => setOpen(false)));
  }
</script>
