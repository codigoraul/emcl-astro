---
import { fallbackSlides } from '../content/fallback';
---

<section class="relative h-[560px] overflow-hidden bg-brand-900 text-white md:h-[640px]" id="hero-slider">
  {fallbackSlides.map((slide, i) => (
    <div
      class="hero-slide absolute inset-0 transition-opacity duration-700 ease-in-out"
      class:list={[i === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0']}
      data-index={i}
    >
      <img src={slide.image} alt={slide.title} class="absolute inset-0 h-full w-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/40 to-transparent"></div>
      <div class="relative mx-auto flex h-full max-w-[1400px] items-center px-6">
        <div class="max-w-xl">
          <h1 class="hero-anim text-3xl font-bold leading-tight md:text-5xl" style="animation-delay: 0.15s;">{slide.title}</h1>
          <p class="hero-anim mt-5 inline-block bg-black/30 px-1 text-base text-white/90 md:text-lg" style="animation-delay: 0.35s;">{slide.text}</p>
          <div class="hero-anim mt-8" style="animation-delay: 0.55s;">
            <a
              href={slide.href}
              class="inline-block bg-brand-logo-blue px-6 py-3 text-sm font-bold uppercase tracking-wide text-white transition hover:bg-brand-700"
            >
              {slide.cta}
            </a>
          </div>
        </div>
      </div>
    </div>
  ))}

  <!-- Flechas -->
  <button
    type="button"
    aria-label="Anterior"
    class="hero-prev absolute left-0 top-1/2 z-20 -translate-y-1/2 bg-black/40 px-3 py-6 text-2xl text-white transition hover:bg-black/60"
  >
    ‹
  </button>
  <button
    type="button"
    aria-label="Siguiente"
    class="hero-next absolute right-0 top-1/2 z-20 -translate-y-1/2 bg-black/40 px-3 py-6 text-2xl text-white transition hover:bg-black/60"
  >
    ›
  </button>

  <!-- Puntos -->
  <div class="absolute bottom-6 left-1/2 z-20 flex -translate-x-1/2 gap-2">
    {fallbackSlides.map((_, i) => (
      <button
        type="button"
        aria-label={`Ir a slide ${i + 1}`}
        class="hero-dot h-2.5 w-2.5 rounded-sm bg-white/40 transition"
        class:list={[i === 0 && 'bg-white']}
        data-index={i}
      ></button>
    ))}
  </div>
</section>

<style>
  .hero-anim {
    opacity: 0;
    transform: translateY(24px);
  }
  .hero-slide.opacity-100 .hero-anim {
    animation: heroFadeUp 0.7s ease-out forwards;
  }
  @keyframes heroFadeUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  const root = document.getElementById('hero-slider');
  if (root) {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.hero-slide'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('.hero-dot'));
    let current = 0;
    let timer: ReturnType<typeof setInterval>;

    function show(index: number) {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        slide.classList.toggle('opacity-100', i === current);
        slide.classList.toggle('z-10', i === current);
        slide.classList.toggle('opacity-0', i !== current);
        slide.classList.toggle('z-0', i !== current);
      });
      dots.forEach((dot, i) => {
        dot.classList.toggle('bg-white', i === current);
        dot.classList.toggle('bg-white/40', i !== current);
      });
    }

    function next() {
      show(current + 1);
    }

    function restartTimer() {
      clearInterval(timer);
      timer = setInterval(next, 6000);
    }

    root.querySelector('.hero-prev')?.addEventListener('click', () => {
      show(current - 1);
      restartTimer();
    });
    root.querySelector('.hero-next')?.addEventListener('click', () => {
      show(current + 1);
      restartTimer();
    });
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        show(Number(dot.dataset.index));
        restartTimer();
      });
    });

    restartTimer();
  }
</script>
