---
import { fallbackServices, fallbackContact } from '../content/fallback';
const year = new Date().getFullYear();
const products = [...fallbackServices].sort((a, b) => (b.order ?? 0) - (a.order ?? 0));
---

<footer class="relative overflow-hidden bg-gradient-to-br from-brand-900 via-brand-800 to-brand-700 pt-16 text-white">
  <div class="pointer-events-none absolute inset-0 opacity-40" style="background-image: repeating-linear-gradient(115deg, rgba(255,255,255,0.06) 0px, rgba(255,255,255,0.06) 1px, transparent 1px, transparent 60px);"></div>
  <div class="pointer-events-none absolute -top-24 -left-24 h-72 w-72 rotate-45 bg-brand-logo-blue/10"></div>

  <div class="relative mx-auto max-w-[1400px] px-6">
    <div class="grid gap-12 pb-14 md:grid-cols-3">
      <div>
        <img src="/img/logo-emcl-blanco.png" alt="EMCL - Estándares Mineros Chile" class="h-12 w-auto" />
        <p class="mt-5 text-sm leading-relaxed text-white/70">
          EMCL es una empresa especializada en la comercialización y elaboración de
          <strong class="text-white">materiales de referencia certificados</strong> (MRC) para la industria minera
          chilena. Nuestro propósito es ofrecer soluciones científicas y técnicas de primer nivel que garanticen la
          calidad, precisión y eficiencia en el sector minero.
        </p>
      </div>

      <div>
        <h3 class="text-lg font-semibold">Nuestros Productos</h3>
        <span class="mt-2 block h-0.5 w-10 bg-brand-logo-blue"></span>
        <ul class="mt-5 space-y-3 text-sm text-white/70">
          {products.map((p) => (
            <li>
              <a href={`/servicios/${p.slug}`} class="transition hover:text-brand-accent-light">{p.title}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-lg font-semibold">Datos de contacto</h3>
        <span class="mt-2 block h-0.5 w-10 bg-brand-logo-blue"></span>
        <ul class="mt-5 space-y-4 text-sm text-white/70">
          <li class="flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mt-0.5 h-5 w-5 shrink-0 text-brand-logo-blue">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0-.414.336-.75.75-.75h18c.414 0 .75.336.75.75v10.5a.75.75 0 0 1-.75.75h-18a.75.75 0 0 1-.75-.75V6.75Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="m3 7 9 6 9-6" />
            </svg>
            <a href={`mailto:${fallbackContact.email}`} class="transition hover:text-brand-accent-light">
              Comercial: {fallbackContact.email}
            </a>
          </li>
          <li class="flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mt-0.5 h-5 w-5 shrink-0 text-brand-logo-blue">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
            </svg>
            <span>{fallbackContact.address}, {fallbackContact.city}, {fallbackContact.region}</span>
          </li>
          <li class="flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mt-0.5 h-5 w-5 shrink-0 text-brand-logo-blue">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h1.5a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106a1.125 1.125 0 0 0-1.173.417l-.97 1.293a11.25 11.25 0 0 1-6.364-6.364l1.293-.97a1.125 1.125 0 0 0 .417-1.173L8.963 3.852a1.125 1.125 0 0 0-1.091-.852H6.5A2.25 2.25 0 0 0 4.25 5.25v1.5Z" />
            </svg>
            <a href={`tel:${fallbackContact.phone.replace(/\s/g, '')}`} class="transition hover:text-brand-accent-light">
              {fallbackContact.phone}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="flex flex-col items-center justify-between gap-2 border-t border-white/10 py-6 text-xs text-white/50 sm:flex-row">
      <p>&copy; {year} — EMCL Estándares Mineros Chile.</p>
      <p>
        Sitio web por
        <a
          href="https://disenopaginas.cl"
          target="_blank"
          rel="noopener noreferrer"
          class="transition hover:text-brand-accent-light"
        >
          disenopaginas.cl
        </a>
      </p>
    </div>
  </div>

  <a
    href="#top"
    aria-label="Volver arriba"
    class="fixed bottom-6 right-6 z-40 flex h-11 w-11 items-center justify-center rounded-full bg-white text-brand-900 shadow-lg transition hover:bg-brand-accent hover:text-white"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5" />
    </svg>
  </a>
</footer>
