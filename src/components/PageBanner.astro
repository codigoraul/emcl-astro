---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  image?: string;
  objectPosition?: string;
}
import { withBase } from '../lib/url';
const { eyebrow, title, description, image, objectPosition = 'center' } = Astro.props;
---

<section class="relative flex h-[264px] items-center overflow-hidden text-white">
  {image ? (
    <>
      <img src={withBase(image)} alt={title} class="absolute inset-0 h-full w-full object-cover" style={`object-position: ${objectPosition};`} />
      <div class="absolute inset-0 bg-gradient-to-r from-brand-900/85 via-brand-900/60 to-brand-900/30"></div>
    </>
  ) : (
    <div class="absolute inset-0 bg-gradient-to-br from-brand-900 via-brand-800 to-brand-700"></div>
  )}

  <div class="relative mx-auto flex w-full max-w-[1400px] items-end justify-between gap-4 px-6">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.15em] text-brand-logo-blue">{eyebrow}</p>
      <h1 class="mt-1.5 text-xl font-bold md:text-2xl">{title}</h1>
      {description && <p class="mt-1.5 max-w-2xl text-sm text-white/75">{description}</p>}
    </div>

    <nav aria-label="Breadcrumb" class="hidden shrink-0 items-center gap-1.5 text-xs text-white/70 sm:flex">
      <a href={withBase('/')} class="transition hover:text-white">Inicio</a>
      <span>›</span>
      <span class="text-white">{eyebrow}</span>
    </nav>
  </div>
</section>
