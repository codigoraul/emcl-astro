---
import type { WPContactInfo } from '../lib/wp';

interface Props {
  contact: WPContactInfo;
}
const { contact } = Astro.props;
---

<section id="contacto" class="bg-slate-50 py-24">
  <div class="mx-auto max-w-[1400px] px-6">
    <div class="overflow-hidden rounded-3xl bg-brand-900 px-8 py-14 text-white md:px-14">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-logo-blue">Contacto</p>
      <h2 class="mt-3 max-w-xl text-3xl font-bold md:text-4xl">Conversemos sobre su proyecto</h2>
      <div class="mt-10 grid gap-6 text-white/80 md:grid-cols-3">
        <div>
          <p class="text-xs uppercase tracking-wide text-white/50">Teléfono</p>
          <a href={`tel:${contact.phone.replace(/\s/g, '')}`} class="mt-1 block text-lg font-bold text-white hover:text-brand-accent-light">
            {contact.phone}
          </a>
          {contact.phoneSecondary && (
            <a href={`tel:${contact.phoneSecondary.replace(/\s/g, '')}`} class="mt-1 block text-lg font-bold text-white hover:text-brand-accent-light">
              {contact.phoneSecondary}
            </a>
          )}
        </div>
        <div>
          <p class="text-xs uppercase tracking-wide text-white/50">Email</p>
          <a href={`mailto:${contact.email}`} class="mt-1 block text-lg font-medium text-white hover:text-brand-accent-light">
            {contact.email}
          </a>
        </div>
        <div>
          <p class="text-xs uppercase tracking-wide text-white/50">Ubicación</p>
          <p class="mt-1 text-lg font-medium text-white">{contact.address}, {contact.city}</p>
          <p class="text-white/60">{contact.region}</p>
        </div>
      </div>
    </div>
  </div>
</section>
