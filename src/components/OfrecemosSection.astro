---

<section class="mx-auto max-w-[1400px] px-6 py-20">
  <div class="mb-12 flex items-center justify-center gap-4">
    <span class="h-px flex-1 max-w-16 bg-brand-900/15"></span>
    <h2 class="text-sm font-bold uppercase tracking-[0.2em] text-brand-900">Beneficios para su empresa</h2>
    <span class="h-px flex-1 max-w-16 bg-brand-900/15"></span>
  </div>

  <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-6 lg:divide-x lg:divide-brand-900/10">
    {fallbackOfrecemos.map((item) => (
      <div class="text-center lg:px-4">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full border border-brand-900/10 text-brand-700">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-6 w-6">
            <path stroke-linecap="round" stroke-linejoin="round" d={icons[item.icon]} />
          </svg>
        </div>
        <h3 class="mt-4 text-sm font-bold uppercase tracking-wide text-brand-900">{item.title}</h3>
        <p class="mt-2 text-sm text-brand-900/60">{item.description}</p>
      </div>
    ))}
  </div>
</section>
