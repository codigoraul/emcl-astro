---
import '../styles/global.css';
import type { WPSeoMeta } from '../lib/wp';
import { withBase } from '../lib/url';

interface Props {
  seo: WPSeoMeta;
  noindex?: boolean;
}

const { seo, noindex = false } = Astro.props;
const canonical = seo.canonical ?? new URL(Astro.url.pathname, Astro.site).toString();

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'EMCL - Estándares Mineros Chile',
  url: 'https://emcl.cl',
  logo: 'https://emcl.cl/img/logo-emcl-blanco.png',
  description:
    'EMCL desarrolla y comercializa Materiales de Referencia Certificados (MRC) para la industria minera chilena.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Parcela 42, El Hinojal',
    addressLocality: 'La Serena',
    addressRegion: 'Región de Coquimbo',
    addressCountry: 'CL',
  },
  email: 'contacto@emcl.cl',
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={withBase('/favicon.png')} />

    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonical} />
    {seo.ogImage && <meta property="og:image" content={seo.ogImage} />}
    <meta property="og:locale" content="es_CL" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />

    <!--
      Nota SEO: cuando WordPress headless esté conectado con Yoast SEO REST API,
      este bloque <head> se reemplaza/complementa con el `yoast_head_json` que
      entrega la API (incluye JSON-LD de Organization, breadcrumbs, etc.) para
      no perder ninguna optimización que Yoast ya calcula.
    -->
    {!noindex && (
      <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    )}
  </head>
  <body class="bg-white text-brand-900 antialiased">
    <slot />
  </body>
</html>
