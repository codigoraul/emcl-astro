---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CompanyIntroSection from '../components/CompanyIntroSection.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import OfrecemosSection from '../components/OfrecemosSection.astro';
import ProcessSection from '../components/ProcessSection.astro';
import Footer from '../components/Footer.astro';
import { getServices, getSeoMeta } from '../lib/wp';

const seo = await getSeoMeta('home');
const services = await getServices();
---

<Layout seo={seo}>
  <Header />
  <Hero />
  <CompanyIntroSection />
  <ServicesGrid services={services} />
  <div class="mx-auto -mt-8 max-w-[1400px] px-6 pb-16 text-center">
    <a href="/servicios" class="text-sm font-semibold text-brand-accent hover:text-brand-700">
      Ver todos los servicios y el proceso completo →
    </a>
  </div>
  <OfrecemosSection />
  <ProcessSection />
  <Footer />
</Layout>
